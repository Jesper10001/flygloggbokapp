{
  "expo": {
    "name": "Blades",
    "slug": "blades-joint-logbook",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/Applogo-cyanonnavy.PNG",
    "userInterfaceStyle": "dark",
    "scheme": "blades",
    "splash": {
      "image": "./assets/logo-splashscreen.PNG",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.blades.jointlogbook",
      "infoPlist": {
        "NSCameraUsageDescription": "Kameran används för att skanna fysiska loggböcker med OCR.",
        "NSPhotoLibraryUsageDescription": "Fotobiblioteket används för att välja bilder för OCR-skanning.",
        "NSLocationWhenInUseUsageDescription": "Platsen används för att hitta din nuvarande position när du loggar tillfälliga landningsplatser.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Applogo-cyanonnavy.PNG",
        "backgroundColor": "#0A1A33"
      },
      "package": "com.blades.jointlogbook",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/Applogo-cyanonnavy.PNG"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Kameran används för OCR-skanning av loggböcker."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Platsen används för att hitta din nuvarande position när du loggar tillfälliga landningsplatser."
        }
      ],
      "@react-native-community/datetimepicker",
      "react-native-document-scanner-plugin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3e7e3c1a-87dd-4aff-95a3-d98170a0f924"
      }
    }
  }
}
