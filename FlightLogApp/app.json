{
  "expo": {
    "name": "Blades",
    "slug": "blades-joint-logbook",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/applogo-cyanonnavy.png",
    "userInterfaceStyle": "dark",
    "scheme": "blades",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.blades.jointlogbook",
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.com.blades.jointlogbook"
        ],
        "com.apple.developer.ubiquity-container-identifiers": [
          "iCloud.com.blades.jointlogbook"
        ],
        "com.apple.developer.icloud-services": [
          "CloudDocuments"
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "The camera is used to scan physical logbooks with OCR.",
        "NSPhotoLibraryUsageDescription": "Your photo library is used to pick images for OCR scanning.",
        "NSLocationWhenInUseUsageDescription": "Your location is used to find your current position when logging temporary landing sites.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSUbiquitousContainers": {
          "iCloud.com.blades.jointlogbook": {
            "NSUbiquitousContainerIsDocumentScopePublic": true,
            "NSUbiquitousContainerName": "Blades Logbook",
            "NSUbiquitousContainerSupportedFolderLevels": "Any"
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/applogo-cyanonnavy.png",
        "backgroundColor": "#0A1A33"
      },
      "package": "com.blades.jointlogbook",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/applogo-cyanonnavy.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-splashscreen.png",
          "imageWidth": 380,
          "resizeMode": "contain",
          "backgroundColor": "#0A1628"
        }
      ],
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "The camera is used for OCR scanning of logbooks."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used to find your current position when logging temporary landing sites."
        }
      ],
      "@react-native-community/datetimepicker",
      "react-native-document-scanner-plugin",
      [
        "expo-media-library",
        {
          "photosPermission": "Your photo library is used to match photos and videos to your logged flights by time. Everything stays on your device.",
          "savePhotosPermission": "Allow the app to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-video",
      "expo-sharing",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID is used to unlock the app when app lock is enabled."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3e7e3c1a-87dd-4aff-95a3-d98170a0f924"
      }
    }
  }
}
